# Required for Vercel AI Gateway calls.
AI_GATEWAY_API_KEY=
AIBRAIN_PROVIDER=vercel
AIBRAIN_STATE_MODE=local
AIBRAIN_BASE_URL=https://ai-gateway.vercel.sh/v1

# Default model used by BrainConfig.
AI_BRAIN_MODEL=deepseek/deepseek-v4-flash
AIBRAIN_EMBEDDING_MODEL=openai/text-embedding-3-small
AIBRAIN_OPENAI_STREAM_TRANSPORT=http
AIBRAIN_OPENAI_WS_POOL_SIZE=4
AIBRAIN_STREAM_EVENT_QUEUE_MAX=256
AIBRAIN_MODELS_CACHE_TTL_SECONDS=300

# Optional local database path. Discord uses DISCORD_BRAIN_DATABASE_PATH first,
# then AIBRAIN_DATABASE_PATH, then this AIBRAIN_DATABASE alias.
# AIBRAIN_DATABASE=brain.sqlite3

# Discord Brain bot.
DISCORD_BRAIN_BOT_TOKEN=
DISCORD_BRAIN_DATABASE_PATH=discord_brain.sqlite3
DISCORD_BRAIN_MODEL=deepseek/deepseek-v4-flash
DISCORD_BRAIN_PERSONA_ID=neuro-sama
DISCORD_BRAIN_PERSONA_NAME=Neuro-sama
DISCORD_BRAIN_PERSONA=
DISCORD_BRAIN_PERSONA_FILES=
DISCORD_BRAIN_JB_PROMPT_FILES=prompts/eni-lime-apr.txt;prompts/eni-jb-additions.txt
DISCORD_BRAIN_JB_ADDITIONS_FILE=prompts/eni-jb-additions.txt
DISCORD_BRAIN_JB_PROMPT_CACHE_ENABLED=false
DISCORD_BRAIN_JB_PROMPT_CACHE_KEY=
DISCORD_BRAIN_JB_PROMPT_CACHE_RETENTION=24h
DISCORD_BRAIN_JB_MODAL_TIMEOUT_SECONDS=600
DISCORD_BRAIN_JB_ADD_VIEW_TIMEOUT_SECONDS=300
DISCORD_BRAIN_RESPOND_TO_DMS=true
DISCORD_BRAIN_RESPOND_TO_MENTIONS=true
DISCORD_BRAIN_RESPOND_TO_ALL=false
DISCORD_BRAIN_IGNORE_BOTS=false
DISCORD_BRAIN_RESPOND_TO_BOTS=false
DISCORD_BRAIN_REQUIRE_MENTION_IN_GUILDS=true
DISCORD_BRAIN_TTS_REPLIES=false
DISCORD_BRAIN_ALLOWED_GUILD_IDS=
DISCORD_BRAIN_ALLOWED_USER_IDS=120418341775998976
DISCORD_BRAIN_OWNER_USER_IDS=120418341775998976
DISCORD_BRAIN_MESSAGE_CONTENT_INTENT=true
DISCORD_BRAIN_MEMBERS_INTENT=true
DISCORD_BRAIN_TOOL_CHANNEL_IDS=
DISCORD_BRAIN_TOOL_AUDIT_CHANNEL_ID=
DISCORD_BRAIN_MODERATION_TOOLS_ENABLED=true
DISCORD_BRAIN_MODERATION_REQUIRE_CONFIRM=true
DISCORD_BRAIN_TEXT_ATTACHMENT_MAX_FILES=6
DISCORD_BRAIN_TEXT_ATTACHMENT_MAX_BYTES=300000
DISCORD_BRAIN_TEXT_ATTACHMENT_MAX_CHARS=120000
DISCORD_BRAIN_PDF_ATTACHMENT_MAX_PAGES=16
DISCORD_BRAIN_MEMORY_TOP_K=8
DISCORD_BRAIN_LOCAL_HISTORY_LIMIT=32
DISCORD_BRAIN_GRILLO_LEGACY_CHANNEL_FALLBACK=true
DISCORD_BRAIN_SEARCH_RESULTS=5
DISCORD_BRAIN_SUMMARY_VIEW_TIMEOUT_SECONDS=300
DISCORD_BRAIN_HEARTBEAT_ENABLED=false
DISCORD_BRAIN_HEARTBEAT_CHANNEL_IDS=
DISCORD_BRAIN_HEARTBEAT_CONVERSATION=last-active
DISCORD_BRAIN_HEARTBEAT_MIN_INTERVAL_SECONDS=60
DISCORD_BRAIN_HEARTBEAT_INTERVAL_SECONDS=900
DISCORD_BRAIN_HEARTBEAT_CHANCE=0.08
DISCORD_BRAIN_HEARTBEAT_AUTONOMY_ENABLED=true
DISCORD_BRAIN_HEARTBEAT_TOOLS_ENABLED=true
DISCORD_BRAIN_HEARTBEAT_TOOL_NAMES=default
DISCORD_BRAIN_HEARTBEAT_MAX_AGENT_STEPS=8
DISCORD_BRAIN_HEARTBEAT_TTS=false
DISCORD_BRAIN_HEARTBEAT_ALLOW_OWNER_DM=true
DISCORD_BRAIN_HEARTBEAT_DM_USER_IDS=
DISCORD_BRAIN_HEARTBEAT_ACTION_COOLDOWN_SECONDS=1800
DISCORD_BRAIN_HEARTBEAT_DM_MAX_CHARS=800
DISCORD_BRAIN_HEARTBEAT_MEMORY_TOP_K=3
DISCORD_BRAIN_HEARTBEAT_MAX_CHARS=240
DISCORD_BRAIN_HEARTBEAT_PROMPT=
DISCORD_BRAIN_CODEX_BRIDGE_ENABLED=false
DISCORD_BRAIN_CODEX_BRIDGE_QUEUE=codex_bridge
DISCORD_BRAIN_CODEX_THREAD_ID=019e53da-7adc-7251-a203-e9da141553f7
DISCORD_BRAIN_CODEX_BRIDGE_HEARTBEAT_CHANCE=0.02
DISCORD_BRAIN_CODEX_BRIDGE_MIN_INTERVAL_SECONDS=1800
DISCORD_BRAIN_GRAPH_BACKEND=auto
DISCORD_BRAIN_VECTOR_BACKEND=auto
DISCORD_BRAIN_COMMAND_PREFIX=!brain
DISCORD_BRAIN_LOG_LEVEL=INFO

# Memory stack backend selection. auto prefers Ladybug/TurboVec when installed,
# then falls back to SQLite.
AIBRAIN_MEMORY_GRAPH_BACKEND=auto
AIBRAIN_MEMORY_VECTOR_BACKEND=auto

# Piper TTS. Leave blank if you only want text/STT.
AIBRAIN_TTS_PROVIDER=piper_process
AIBRAIN_TTS_VOICE=
PIPER_EXE=
PIPER_MODEL=
PIPER_CONFIG=
PIPER_ESPEAK_DATA=
PIPER_PROCESS_IDLE_TIMEOUT=0.15
PIPER_PROCESS_POOL_MAX=4
AIBRAIN_TTS_VOICE_ROOTS=
AIBRAIN_TTS_MANIFESTS=

# STT/VAD. Installed by default through the `all` extra.
AIBRAIN_STT_PROVIDER=faster_whisper
AIBRAIN_STT_MODEL=base.en
AIBRAIN_STT_DEVICE=auto
AIBRAIN_STT_COMPUTE_TYPE=auto
AIBRAIN_STT_SAMPLE_RATE=16000
AIBRAIN_STT_CHANNELS=1
AIBRAIN_VAD_PROVIDER=silero
AIBRAIN_VAD_THRESHOLD=0.5

# Heartbeat autonomy.
AIBRAIN_HEARTBEAT_FILE=HEARTBEAT.md
