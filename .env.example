# Required for Vercel AI Gateway calls.
AI_GATEWAY_API_KEY=
AIBRAIN_PROVIDER=vercel
AIBRAIN_STATE_MODE=local
AIBRAIN_BASE_URL=https://ai-gateway.vercel.sh/v1

# Default model used by BrainConfig.
AI_BRAIN_MODEL=deepseek/deepseek-v4-flash
AIBRAIN_EMBEDDING_MODEL=openai/text-embedding-3-small
AIBRAIN_OPENAI_STREAM_TRANSPORT=http
AIBRAIN_OPENAI_WS_POOL_SIZE=4
AIBRAIN_STREAM_EVENT_QUEUE_MAX=256
AIBRAIN_MODELS_CACHE_TTL_SECONDS=300

# Optional local database path.
# AIBRAIN_DATABASE=brain.sqlite3

# Discord Brain bot.
DISCORD_BRAIN_BOT_TOKEN=
DISCORD_BRAIN_DATABASE_PATH=discord_brain.sqlite3
DISCORD_BRAIN_MODEL=deepseek/deepseek-v4-flash
DISCORD_BRAIN_PERSONA_ID=neuro-sama
DISCORD_BRAIN_PERSONA_NAME=Neuro-sama
DISCORD_BRAIN_PERSONA=
DISCORD_BRAIN_PERSONA_FILES=
DISCORD_BRAIN_RESPOND_TO_DMS=true
DISCORD_BRAIN_RESPOND_TO_MENTIONS=true
DISCORD_BRAIN_RESPOND_TO_ALL=false
DISCORD_BRAIN_ALLOWED_GUILD_IDS=
DISCORD_BRAIN_ALLOWED_USER_IDS=
DISCORD_BRAIN_MEMORY_TOP_K=8
DISCORD_BRAIN_LOCAL_HISTORY_LIMIT=32
DISCORD_BRAIN_GRAPH_BACKEND=auto
DISCORD_BRAIN_VECTOR_BACKEND=auto
DISCORD_BRAIN_COMMAND_PREFIX=!brain
DISCORD_BRAIN_LOG_LEVEL=INFO

# Memory stack backend selection. auto prefers Ladybug/TurboVec when installed,
# then falls back to SQLite.
AIBRAIN_MEMORY_GRAPH_BACKEND=auto
AIBRAIN_MEMORY_VECTOR_BACKEND=auto

# Piper TTS. Leave blank if you only want text/STT.
AIBRAIN_TTS_PROVIDER=piper_process
AIBRAIN_TTS_VOICE=
PIPER_EXE=
PIPER_MODEL=
PIPER_CONFIG=
PIPER_ESPEAK_DATA=
PIPER_PROCESS_IDLE_TIMEOUT=0.15
PIPER_PROCESS_POOL_MAX=4
AIBRAIN_TTS_VOICE_ROOTS=
AIBRAIN_TTS_MANIFESTS=

# STT/VAD. Installed by default through the `all` extra.
AIBRAIN_STT_PROVIDER=faster_whisper
AIBRAIN_STT_MODEL=base.en
AIBRAIN_STT_DEVICE=auto
AIBRAIN_STT_COMPUTE_TYPE=auto
AIBRAIN_STT_SAMPLE_RATE=16000
AIBRAIN_STT_CHANNELS=1
AIBRAIN_VAD_PROVIDER=silero
AIBRAIN_VAD_THRESHOLD=0.5

# Heartbeat autonomy.
AIBRAIN_HEARTBEAT_FILE=HEARTBEAT.md
